#!/usr/bin/env bash

set -e

URL="$1"
DEST="${2:-$HOME/Downloads}"

if [[ -z "$URL" || "$URL" == "--help" || "$URL" == "-h" ]]; then
  echo "Usage: justavideo <video-url> [destination]"
  exit 0
fi

if ! command -v yt-dlp >/dev/null 2>&1; then
  echo "yt-dlp is not installed. Run the installer again."
  exit 1
fi

if [[ ! -t 0 || ! -t 1 ]]; then
  echo "An interactive terminal is required."
  exit 1
fi

SELECTED_INDEX=0
SELECTED_VALUE=""

select_option() {
  local title="$1"
  shift
  local options=("$@")
  local selected=0
  local key sequence index

  while true; do
    printf '\033[2J\033[H%s\nUse the arrow keys and Enter. Press q to cancel.\n\n' "$title"
    for index in "${!options[@]}"; do
      if [[ $index -eq $selected ]]; then
        printf '› %s\n' "${options[$index]}"
      else
        printf '  %s\n' "${options[$index]}"
      fi
    done

    IFS= read -rsn1 key
    case "$key" in
      $'\x1b')
        IFS= read -rsn2 sequence || true
        case "$sequence" in
          '[A') if (( selected > 0 )); then selected=$((selected - 1)); fi;;
          '[B') if (( selected < ${#options[@]} - 1 )); then selected=$((selected + 1)); fi;;
          '') return 1;;
        esac
        ;;
      ''|$'\n'|$'\r')
        SELECTED_INDEX=$selected
        SELECTED_VALUE="${options[$selected]}"
        return 0
        ;;
      q|Q) return 1;;
    esac
  done
}

mode_options=("MP4 video" "MP3 audio")
select_option "Choose a format" "${mode_options[@]}" || exit 0

mkdir -p "$DEST"

if [[ "$SELECTED_INDEX" -eq 0 ]]; then
  format_ids=()
  format_labels=()
  format_modes=()

  while IFS=$'\t' read -r format_id resolution mode; do
    format_ids+=("$format_id")
    format_labels+=("$resolution mp4")
    format_modes+=("$mode")
  done < <(yt-dlp --extractor-args "youtube:player_client=web_embedded" --no-playlist -F "$URL" | awk '$1 != "ID" && $2 == "mp4" && $3 ~ /^[0-9]+x[0-9]+$/ && $0 !~ /images/ && !seen[$3]++ { mode = ($0 ~ /video only/) ? "video-only" : "with-audio"; print $1 "\t" $3 "\t" mode }')

  if [[ ${#format_labels[@]} -eq 0 ]]; then
    echo "No MP4 formats were found."
    exit 1
  fi

  select_option "Choose a resolution" "${format_labels[@]}" || exit 0
  format_id="${format_ids[$SELECTED_INDEX]}"
  format_mode="${format_modes[$SELECTED_INDEX]}"
  if [[ "$format_mode" == "video-only" ]]; then
    format_selector="$format_id+bestaudio[ext=m4a]/$format_id+bestaudio/$format_id"
  else
    format_selector="$format_id"
  fi

  yt-dlp --extractor-args "youtube:player_client=web_embedded" --no-playlist -f "$format_selector" --merge-output-format mp4 --embed-thumbnail --add-metadata --progress -o "$DEST/%(title)s.%(ext)s" "$URL"
else
  quality_values=("320K" "256K" "192K" "128K")
  quality_labels=("320 kbps" "256 kbps" "192 kbps" "128 kbps")
  select_option "Choose MP3 quality" "${quality_labels[@]}" || exit 0
  audio_quality="${quality_values[$SELECTED_INDEX]}"
  yt-dlp --extractor-args "youtube:player_client=web_embedded" --no-playlist -x --audio-format mp3 --audio-quality "$audio_quality" --embed-thumbnail --add-metadata --progress -o "$DEST/%(title)s.%(ext)s" "$URL"
fi

echo "Saved to $DEST"
